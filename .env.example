# App: production checks require all operational settings and official SVG.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GET_STARTED_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# PostgreSQL: pooled for runtime, direct for Prisma migrations
DATABASE_URL=
DIRECT_URL=
# Scheduling: path only, e.g. team/your-team/your-event (not a full URL)
NEXT_PUBLIC_CALCOM_LINK=
NEXT_PUBLIC_CALCOM_NAMESPACE=demo
CALCOM_WEBHOOK_SECRET=
# CRM: verify generic endpoints/mapper against the real backend contract first
CRM_ADAPTER=mock
CRM_CONTRACT_VERIFIED=false
CRM_BASE_URL=
CRM_API_KEY=
# Consent-gated marketing
NEXT_PUBLIC_GTM_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_API_VERSION=v23.0
META_TEST_EVENT_CODE=
# Rate limit and notifications
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Sentry DSNs (client DSN is public; auth token is server/build-only)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Routing: comma-separated presenter/closing addresses
ROUTE_QUALIFIER_EMAIL=
ROUTE_PRESENTER_EMAILS=
ROUTE_CLOSING_EMAILS=
# Dedicated disposable PostgreSQL URL for integration tests only
TEST_DATABASE_URL=
