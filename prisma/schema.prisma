generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id          String   @id @default(cuid())
  companyName String
  fullName    String
  email       String
  mobile      String
  interest    String
  message     String?
  slotStart   DateTime @unique
  slotEnd     DateTime
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model DailyQuota {
  key   String @id
  count Int    @default(0)
}
