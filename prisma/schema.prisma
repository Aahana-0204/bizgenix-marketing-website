generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
enum LeadKind {
 DEMO_BOOKING
 PLAN_ENQUIRY
}
enum LeadStatus {
 NEW
 QUALIFIED
 BOOKED
 CONTACTED
 LOST
}
enum BookingStatus {
 PENDING
 CONFIRMED
 RESCHEDULED
 CANCELLED
 NO_SHOW
}
enum OutboxStatus {
 PENDING
 PROCESSING
 DONE
 FAILED
}
model Lead {
 id String @id @default(cuid())
 dedupeKey String @unique
 kind LeadKind
 fullName String
 companyName String
 email String
 phoneE164 String
 industry String?
 teamSize String?
 interestedIn String?
 painPoint String?
 planInterest String?
 consentAt DateTime
 consentSource String
 marketingConsent Boolean @default(false)
 status LeadStatus @default(NEW)
 assignedOwner String?
 followUpAt DateTime?
 qualificationNotes String?
 utmSource String?
 utmMedium String?
 utmCampaign String?
 utmContent String?
 utmTerm String?
 gclid String?
 fbclid String?
 fbp String?
 fbc String?
 landingPageUrl String?
 referrer String?
 crmLeadId String?
 crmSyncedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 bookings Booking[]
 @@index([email])
 @@index([createdAt])
}
model Booking {
 id String @id @default(cuid())
 calBookingUid String @unique
 provider String @default("calcom")
 leadId String?
 lead Lead? @relation(fields:[leadId],references:[id],onDelete:SetNull)
 status BookingStatus
 startAt DateTime
 endAt DateTime
 timezone String
 presenter String?
 meetingUrl String?
 rawPayload Json
 eventAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([leadId, eventAt])
}
model GoogleCalendarConnection {
 email String @id
 encryptedRefreshToken String
 connectedAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
// Durable holds survive ambiguous Google responses; retries recover the same event ID.
model CalendarReservation {
 id String @id
 requestKey String @unique
 leadId String
 presenter String
 eventId String @unique
 startAt DateTime
 endAt DateTime
 status String @default("PENDING")
 processingUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([presenter, startAt, endAt])
}
model WebhookEvent {
 id String @id @default(cuid())
 provider String
 externalId String
 type String
 receivedAt DateTime @default(now())
 @@unique([provider, externalId, type])
}
model OutboxJob {
 id String @id @default(cuid())
 type String
 payload Json
 idempotencyKey String @unique
 status OutboxStatus @default(PENDING)
 attempts Int @default(0)
 nextRunAt DateTime @default(now())
 lockedAt DateTime?
 leaseToken String?
 lastError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, nextRunAt])
}
